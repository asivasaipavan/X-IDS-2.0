# Django
DJANGO_SECRET_KEY=change-this-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional PostgreSQL. Leave blank to use local SQLite.
# DATABASE_URL=postgresql://xids:xids_local_dev@127.0.0.1:5432/xids

# Optional IP reputation API
ABUSEIPDB_API_KEY=

# Optional MaxMind GeoLite2 City database (.mmdb)
GEOIP_DB_PATH=

# Optional email alerts (use an app password where required)
XIDS_EMAIL_ENABLED=false
XIDS_ALERT_RECIPIENT=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Comma-separated public IP allowlist. Local/private IPs are blocked from firewall actions regardless.
XIDS_IP_WHITELIST=127.0.0.1,::1
